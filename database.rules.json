{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "auth != null && (data.child('owner').val() === auth.uid || data.child('guest').val() === auth.uid)",
        ".write": "auth != null && !data.exists() && $room.matches(/^[A-F0-9]{12}$/) && newData.child('owner').val() === auth.uid && !newData.hasChild('guest') && !newData.hasChild('strokes') && !newData.hasChild('presence')",
        ".validate": "newData.hasChildren(['owner', 'settings'])",
        "owner": {
          ".validate": "newData.isString() && newData.val().length <= 128 && (!data.exists() || newData.val() === data.val())"
        },
        "guest": {
          ".write": "auth != null && root.child('rooms').child($room).hasChild('owner') && root.child('rooms').child($room).child('owner').val() !== auth.uid && newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid)",
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "settings": {
          ".write": "auth != null && root.child('rooms').child($room).child('owner').val() === auth.uid && newData.exists()",
          ".validate": "newData.hasChildren(['mode','seed','round'])",
          "mode": {".validate": "newData.val() === 'split' || newData.val() === 'free'"},
          "seed": {".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5 && newData.val() % 1 === 0"},
          "round": {".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"},
          "$other": {".validate": false}
        },
        "strokes": {
          "$stroke": {
            ".write": "auth != null && (root.child('rooms').child($room).child('owner').val() === auth.uid || root.child('rooms').child($room).child('guest').val() === auth.uid) && newData.exists() && newData.child('uid').val() === auth.uid && (!data.exists() || data.child('uid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['uid','round','side','tool','color','size','opacity','visible','points']) && newData.child('round').val() === root.child('rooms').child($room).child('settings/round').val() && (root.child('rooms').child($room).child('settings/mode').val() === 'free' ? newData.child('side').val() === 'all' : (root.child('rooms').child($room).child('owner').val() === auth.uid ? newData.child('side').val() === 'left' : newData.child('side').val() === 'right'))",
            "uid": {".validate": "newData.val() === auth.uid"},
            "round": {".validate": "newData.isString() && newData.val().length <= 64"},
            "side": {".validate": "newData.val() === 'all' || newData.val() === 'left' || newData.val() === 'right'"},
            "tool": {".validate": "newData.isString() && newData.val().matches(/^(pencil|ink|brush|water|marker|crayon|spray|eraser)$/)"},
            "color": {".validate": "newData.isString() && newData.val().matches(/^#[a-fA-F0-9]{6}$/)"},
            "size": {".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 80"},
            "opacity": {".validate": "newData.isNumber() && newData.val() >= 0.05 && newData.val() <= 1"},
            "visible": {".validate": "newData.isBoolean()"},
            "points": {".validate": "newData.isString() && newData.val().length <= 24000"},
            "$other": {".validate": false}
          }
        },
        "presence": {
          "$uid": {
            "$connection": {
              ".write": "auth != null && auth.uid === $uid && (root.child('rooms').child($room).child('owner').val() === auth.uid || root.child('rooms').child($room).child('guest').val() === auth.uid)",
              ".validate": "newData.val() === true"
            }
          }
        },
        "$other": {".validate": false}
      }
    }
  }
}
